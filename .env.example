# Server
PORT=8080
NODE_ENV=development
TRUST_PROXY=1

# Admin authentication
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-strong-password

# Session / cookies
SESSION_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CSRF / rate limit tuning (optional)
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
ADMIN_RATE_LIMIT_WINDOW_MS=900000
ADMIN_RATE_LIMIT_MAX=300

# Storage (Vercel / serverless)
# If DATABASE_URL is set, projects and sessions use Postgres.
# If BLOB_READ_WRITE_TOKEN is set, uploads use Vercel Blob.
# If unset, app falls back to local JSON file + local uploads (development).
# DATABASE_URL=postgres://...
# POSTGRES_URL=postgres://...
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# SEO (optional)
# SITE_URL=https://your-domain.example

